<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:id="@+id/main"
	>
	
	<TextView
		android:id="@+id/textView"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="#ff5722"
		android:text="Information"
		android:textAlignment="center"
		android:textColor="#fff"
		android:textSize="22sp"
		android:textStyle="bold"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent"
		/>
	
	<TableLayout
		android:id="@+id/tableLayout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:stretchColumns="*"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/textView"
		>
		
		<TableRow
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			>
			
			<TextView
				android:layout_width="wrap_content"
				android:text="Name"
				android:textColor="#009688"
				android:textSize="20sp"
				/>
			
			<EditText
				android:id="@+id/name"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:autofillHints="name"
				android:hint="name"
				android:inputType="text"
				android:labelFor="@id/name"
				android:textSize="20sp"
				/>
		</TableRow>
		
		<TableRow
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			>
			
			<TextView
				android:layout_width="wrap_content"
				android:text="Age"
				android:textColor="#009688"
				android:textSize="20sp"
				/>
			
			<EditText
				android:id="@+id/age"
				android:layout_width="300dp"
				android:layout_height="wrap_content"
				android:autofillHints="name"
				android:inputType="text"
				android:labelFor="@id/age"
				android:textSize="20sp"
				android:hint="age"
				/>
		</TableRow>
	</TableLayout>
	
	<TextView
		android:id="@+id/level"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="#4caf50"
		android:text="Level"
		android:textAlignment="center"
		android:textSize="22sp"
		android:textStyle="bold|italic"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@+id/tableLayout"
		/>
	
	<RadioGroup
		android:id="@+id/radioGroupLevel"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@+id/level"
		>
		
		<RadioButton
			android:id="@+id/rdbBeginner"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="Beginner"
			android:textSize="20sp"
			/>
		
		<RadioButton
			android:id="@+id/rdbMedium"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:checked="true"
			android:text="Medium"
			android:textSize="20sp"
			/>
		
		<RadioButton
			android:id="@+id/rdbExpert"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="Expert"
			android:textSize="20sp"
			/>
	</RadioGroup>
	
	<TextView
		android:id="@+id/textView2"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="#4caf50"
		android:text="Hobby"
		android:textAlignment="center"
		android:textSize="22sp"
		android:textStyle="bold|italic"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@+id/radioGroupLevel"
		/>
	
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@+id/textView2"
		android:id="@+id/linearLayout"
		>
		
		<CheckBox
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Reading"
			android:textSize="20sp"
			android:id="@+id/checkBoxReading"
			/>
		
		<CheckBox
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Coding"
			android:id="@+id/checkBoxCoding"
			android:textSize="20sp"
			/>
		
		<CheckBox
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Gaming"
			android:textSize="20sp"
			android:id="@+id/checkBoxGaming"
			/>
	
	</LinearLayout>
	<TextView
		android:id="@+id/textView3"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="#4caf50"
		android:text="Extra Information"
		android:textAlignment="center"
		android:textSize="22sp"
		android:textStyle="bold|italic"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@+id/linearLayout"
		/>
	<EditText
		android:hint="Extra Information"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@+id/textView3"
		android:autofillHints="name"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="top|start"
		android:inputType="textMultiLine"
		android:minLines="3"
		android:id="@+id/extraInfo"
		/>
	<Button
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="Submit"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@+id/extraInfo"
		android:textSize="20sp"
		android:id="@+id/submitButton"
		/>
</androidx.constraintlayout.widget.ConstraintLayout>





















