<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/main"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	tools:context=".activity.ResultActivity"
	android:orientation="vertical"
	>
	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:textSize="24sp"
		android:text="Data"
		android:gravity="center"
		/>
	<androidx.constraintlayout.widget.ConstraintLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		>
		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:id="@+id/textViewReceivedDataLabel"
			android:textSize="20sp"
			android:text="Data Received: "
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintBottom_toBottomOf="parent"
			app:layout_constraintTop_toTopOf="parent"
			/>
		<EditText
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:id="@+id/textViewReceivedData"
			android:inputType="text"
			android:labelFor="@+id/textViewReceivedData"
			android:autofillHints="name"
			android:text="Data"
			app:layout_constraintStart_toEndOf="@+id/textViewReceivedDataLabel"
			app:layout_constraintTop_toTopOf="parent"
			android:textSize="20sp"
			android:layout_marginStart="20dp"
			/>
	</androidx.constraintlayout.widget.ConstraintLayout>
	<LinearLayout
		style="?android:attr/buttonBarStyle"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:weightSum="2"
		>
		
		<Button
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Send Original Data"
			android:id="@+id/buttonSendOriginalData"
			android:layout_weight="1"
			/>
		
		<Button
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Send Modified Data"
			android:layout_weight="1"
			android:id="@+id/buttonSendModifiedData"
			/>
	</LinearLayout>
</LinearLayout>

























