<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
	>
	
	<uses-permission android:name="android.permission.READ_CONTACTS" />
	
	<application
		android:name=".MainApplication"
		android:allowBackup="true"
		android:dataExtractionRules="@xml/data_extraction_rules"
		android:fullBackupContent="@xml/backup_rules"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:supportsRtl="true"
		android:theme="@style/Theme.DemoPrm392"
		tools:targetApi="31"
		>
		<provider
			android:name=".demo_round2.MyContentProvider"
			android:authorities="com.example.demoprm392"
			android:exported="true"
			>
		</provider>
		
		<activity
			android:name=".demo_round2.MainActivity"
			android:exported="true"
			>
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>
		<activity
			android:name=".demo.PopUpMenu"
			android:exported="false"
			/>
		<activity
			android:name=".demo.ContextualMenu"
			android:exported="false"
			/>
		<activity
			android:name=".demo.ContextMenu"
			android:exported="false"
			/>
		<activity
			android:name=".demo.OptionsMenuDemo"
			android:exported="true"
			>
		</activity>
		<activity
			android:name=".demo.SpinnerDemo"
			android:exported="true"
			>
		</activity>
		<activity
			android:name=".MainActivity"
			android:exported="true"
			>
		</activity>
	</application>

</manifest>